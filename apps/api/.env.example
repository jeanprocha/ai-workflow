DATABASE_URL="postgresql://workflow:workflow@localhost:5433/workflow"
REDIS_URL="redis://localhost:6380"
PORT=3333

# Observabilidade (logging estruturado — apps/api/src/observability)
LOG_LEVEL=info
# 1 = pino-pretty (legivel, default fora de producao); 0 = JSON puro
LOG_PRETTY=1
# Porta do mini servidor HTTP do worker (/metrics + /health) — Railway injeta
# PORT em todo servico, entao WORKER_PORT so importa em dev local.
WORKER_PORT=3334
# 1 = habilita GET /debug/logs (API e worker) — NUNCA setar em producao.
# Usado pela suite E2E (apps/e2e) pra anexar logs do servidor a testes que falharem.
OBS_DEBUG_ENDPOINT=1

# Secrets (Fase 2)
JWT_SECRET="change-me"
SECRETS_ENCRYPTION_KEY="change-me-32-bytes-min"

# Providers de IA (Fase 5)
OPENAI_API_KEY=
ANTHROPIC_API_KEY=
GEMINI_API_KEY=
OLLAMA_BASE_URL="http://localhost:11434"
# Rate limit por provider (requests/min) — default no codigo se omitido
# (packages/ai/src/rate-limiter.ts): openai=60, anthropic=60, gemini=60, ollama=600.
# AI_RATE_LIMIT_OPENAI_RPM=60
# AI_RATE_LIMIT_ANTHROPIC_RPM=60
# AI_RATE_LIMIT_GEMINI_RPM=60
# AI_RATE_LIMIT_OLLAMA_RPM=600

# Grafana/Prometheus locais (Fase 8, opcional) — nao lido pela API, so pelo
# docker-compose (infra/observability/). Sobe com:
#   docker compose --profile observability up -d
# Grafana em http://localhost:3005 (anonimo, sem login), Prometheus em
# http://localhost:9090 — scrape de host.docker.internal:3333 (API) e :3334
# (worker), so funciona com os dois processos rodando localmente.

# Email de sistema + reset de senha (H1.5) — Mailpit local (docker-compose.dev.yml)
SMTP_HOST=localhost
SMTP_PORT=1025
EMAIL_FROM="no-reply@workflow.local"
WEB_URL="http://localhost:3000"

# Alerting de falhas de execucao (H1.6, opcional) — reusa SMTP_* acima
# ALERT_THROTTLE_MINUTES=10
