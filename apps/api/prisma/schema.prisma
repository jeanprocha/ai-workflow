// Modelo de dados do Workflow AI Platform (ver plan.md secao 3).
// Multi-tenancy por workspace desde a Fase 2 (ADR-006): todo recurso de
// negocio abaixo carrega workspace_id.

generator client {
  provider        = "prisma-client-js"
  previewFeatures = ["postgresqlExtensions"]
}

datasource db {
  provider   = "postgresql"
  url        = env("DATABASE_URL")
  extensions = [vector]
}

model User {
  id           String   @id @default(uuid())
  email        String   @unique
  name         String
  passwordHash String   @map("password_hash")
  createdAt    DateTime @default(now()) @map("created_at")

  memberships         WorkspaceMember[]
  createdVersions     WorkflowVersion[]
  passwordResetTokens PasswordResetToken[]

  @@map("users")
}

/**
 * Reset de senha (H1.5): token bruto (32 bytes aleatorios) so existe no link
 * enviado por email — aqui so o hash (sha256), pra um dump do banco nunca
 * dar reset de senha de graca em ninguem. TTL curto (~30min, aplicado no
 * service, nao no schema) + single-use (usedAt).
 */
model PasswordResetToken {
  id        String    @id @default(uuid())
  userId    String    @map("user_id")
  tokenHash String    @unique @map("token_hash")
  expiresAt DateTime  @map("expires_at")
  usedAt    DateTime? @map("used_at")
  createdAt DateTime  @default(now()) @map("created_at")

  user User @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@index([userId])
  @@map("password_reset_tokens")
}

enum WorkspaceRole {
  owner
  admin
  member
}

model Workspace {
  id        String   @id @default(uuid())
  name      String
  createdAt DateTime @default(now()) @map("created_at")

  members        WorkspaceMember[]
  workflows      Workflow[]
  credentials    Credential[]
  variables      Variable[]
  agents         Agent[]
  knowledgeBases KnowledgeBase[]
  mcpServers     McpServer[]
  aiSuggestions  AiSuggestion[]
  nodePresets    NodePreset[]
  alertSetting   WorkspaceAlertSetting?
  templates      Template[]

  @@map("workspaces")
}

/**
 * Alerting de falhas de execucao (H1.6) — MVP: sem linha, comportamento
 * default e email habilitado (ver alerts.service.ts). Linha so passa a
 * existir quando o workspace muda a config pela primeira vez (PUT).
 */
model WorkspaceAlertSetting {
  workspaceId  String   @id @map("workspace_id")
  emailEnabled Boolean  @default(true) @map("email_enabled")
  webhookUrl   String?  @map("webhook_url")
  updatedAt    DateTime @updatedAt @map("updated_at")

  workspace Workspace @relation(fields: [workspaceId], references: [id], onDelete: Cascade)

  @@map("workspace_alert_settings")
}

model WorkspaceMember {
  workspaceId String        @map("workspace_id")
  userId      String        @map("user_id")
  role        WorkspaceRole @default(member)
  createdAt   DateTime      @default(now()) @map("created_at")

  workspace Workspace @relation(fields: [workspaceId], references: [id], onDelete: Cascade)
  user      User      @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@id([workspaceId, userId])
  @@index([userId])
  @@map("workspace_members")
}

enum WorkflowStatus {
  draft
  active
  archived
}

model Workflow {
  id                String         @id @default(uuid())
  workspaceId       String         @map("workspace_id")
  name              String
  description       String?
  status            WorkflowStatus @default(draft)
  currentVersionId  String?        @unique @map("current_version_id")
  /** Sincronizado a cada save do grafo: id do node trigger.webhook, se houver. */
  webhookId         String?        @unique @map("webhook_id")
  /** Sincronizados a cada save do grafo: tokens do node trigger.chat, se houver. */
  chatToken         String?        @unique @map("chat_token")
  inboxToken        String?        @unique @map("inbox_token")
  /** H2-05: fluxo disparado quando ESTE fluxo falha. onDelete:SetNull — apagar o tratador so degrada pra "sem error workflow", nunca bloqueia. */
  errorWorkflowId   String?        @map("error_workflow_id")
  createdAt         DateTime       @default(now()) @map("created_at")
  updatedAt         DateTime       @updatedAt @map("updated_at")

  workspace        Workspace         @relation(fields: [workspaceId], references: [id], onDelete: Cascade)
  versions         WorkflowVersion[] @relation("WorkflowVersions")
  currentVersion   WorkflowVersion?  @relation("CurrentVersion", fields: [currentVersionId], references: [id])
  executions       Execution[]
  aiSuggestions    AiSuggestion[]
  conversations    Conversation[]
  apiKeys          WorkflowApiKey[]
  errorWorkflow    Workflow?         @relation("ErrorWorkflow", fields: [errorWorkflowId], references: [id], onDelete: SetNull)
  errorWorkflowFor Workflow[]        @relation("ErrorWorkflow")

  @@index([workspaceId])
  @@index([errorWorkflowId])
  @@map("workflows")
}

/**
 * H2-04: chave de API por fluxo (POST /v1/flows/:id/invoke). Valor bruto
 * (wfk_ + 32 bytes hex) so existe na resposta da criacao; aqui so o sha256 —
 * dump do banco nao habilita nada. Lookup por indice unico no hash dispensa
 * timingSafeEqual (nao ha comparacao byte a byte de segredo — mesmo padrao
 * de tokens tipo GitHub). Revogar = revokedAt, nunca hard delete
 * (auditabilidade). Multiplas chaves ativas por fluxo = rotacao sem downtime.
 */
model WorkflowApiKey {
  id         String    @id @default(uuid())
  workflowId String    @map("workflow_id")
  name       String
  keyHash    String    @unique @map("key_hash")
  lastFour   String    @map("last_four")
  createdAt  DateTime  @default(now()) @map("created_at")
  lastUsedAt DateTime? @map("last_used_at")
  revokedAt  DateTime? @map("revoked_at")

  workflow Workflow @relation(fields: [workflowId], references: [id], onDelete: Cascade)

  @@index([workflowId])
  @@map("workflow_api_keys")
}

model WorkflowVersion {
  id            String   @id @default(uuid())
  workflowId    String   @map("workflow_id")
  versionNumber Int      @map("version_number")
  graph         Json
  createdById   String   @map("created_by")
  createdAt     DateTime @default(now()) @map("created_at")

  workflow    Workflow    @relation("WorkflowVersions", fields: [workflowId], references: [id], onDelete: Cascade)
  createdBy   User        @relation(fields: [createdById], references: [id])
  currentOf   Workflow?   @relation("CurrentVersion")
  executions  Execution[]

  @@unique([workflowId, versionNumber])
  @@map("workflow_versions")
}

model Credential {
  id            String   @id @default(uuid())
  workspaceId   String   @map("workspace_id")
  provider      String
  name          String
  encryptedData String   @map("encrypted_data")
  lastFour      String?  @map("last_four")
  createdAt     DateTime @default(now()) @map("created_at")
  updatedAt     DateTime @updatedAt @map("updated_at")

  /// "secret" = um valor unico (token, webhook URL, connection string).
  /// "fields" = varios pares chave/valor, guardados como um objeto JSON —
  /// e o que o node HTTP expoe como {{ $auth.<chave> }}.
  kind String @default("secret")

  /// [{ key, type }] de cada campo quando kind = "fields". Guardado SEM
  /// criptografia de proposito: nome e tipo de chave nao sao segredo, e ter
  /// isso em claro permite (a) listar as conexoes sem descriptografar nada e
  /// (b) a tela de edicao pre-preencher as chaves com o TIPO certo — sem
  /// isso, editar rebaixaria silenciosamente um campo numerico pra texto.
  /// O VALOR de cada campo nunca mora aqui, so dentro de encryptedData.
  fieldsMeta Json? @map("fields_meta")

  workspace Workspace @relation(fields: [workspaceId], references: [id], onDelete: Cascade)

  // Unico por nome dentro do workspace: todo consumidor (engine, agents,
  // copilot, debugger, autocomplete) resolve credencial pelo NOME via
  // findFirst — com duplicata, qual delas vence seria indefinido.
  @@unique([workspaceId, name])
  @@index([workspaceId])
  @@map("credentials")
}

enum VariableScope {
  global
  environment
  runtime
}

model Variable {
  id          String        @id @default(uuid())
  workspaceId String        @map("workspace_id")
  key         String
  value       String
  isSecret    Boolean       @default(false) @map("is_secret")
  scope       VariableScope @default(global)
  createdAt   DateTime      @default(now()) @map("created_at")

  workspace Workspace @relation(fields: [workspaceId], references: [id], onDelete: Cascade)

  @@unique([workspaceId, key])
  @@map("variables")
}

/**
 * Predefinicao de config salva por tipo de node (ex.: um node HTTP Request
 * ja pronto pra chamar um ERP assinado) — reusavel entre fluxos do mesmo
 * workspace, sem repetir a configuracao node a node. `config` e mesclado por
 * cima do config atual do node ao aplicar (ver ConfigPanel > PresetBar).
 */
model NodePreset {
  id          String   @id @default(uuid())
  workspaceId String   @map("workspace_id")
  nodeType    String   @map("node_type")
  name        String
  description String   @default("")
  config      Json
  createdAt   DateTime @default(now()) @map("created_at")
  updatedAt   DateTime @updatedAt @map("updated_at")

  workspace Workspace @relation(fields: [workspaceId], references: [id], onDelete: Cascade)

  @@unique([workspaceId, nodeType, name])
  @@index([workspaceId, nodeType])
  @@map("node_presets")
}

enum ExecutionStatus {
  queued
  running
  /** H2-06: pausada num node de aprovacao humana, esperando decisao (ou timeout do sweeper). */
  waiting_approval
  success
  failed
  canceled
}

enum TriggerType {
  manual
  webhook
  cron
  event
  chat
}

model Execution {
  id                String          @id @default(uuid())
  workflowId        String          @map("workflow_id")
  versionId         String          @map("version_id")
  status            ExecutionStatus @default(queued)
  triggerType       TriggerType     @map("trigger_type")
  inputPayload      Json?           @map("input_payload")
  outputPayload     Json?           @map("output_payload")
  durationMs        Int?            @map("duration_ms")
  tokensTotal       Int             @default(0) @map("tokens_total")
  costUsd           Float           @default(0) @map("cost_usd")
  startedAt         DateTime        @default(now()) @map("started_at")
  finishedAt        DateTime?       @map("finished_at")
  error             String?
  parentExecutionId String?         @map("parent_execution_id")
  /** Agrupa uma execucao com todos os seus replays (Fase 6). Nula em execucoes anteriores a Fase 6. */
  traceId           String?         @map("trace_id")
  /** Node a partir do qual esta execucao foi um replay parcial, se houver. */
  replayFromNodeId  String?         @map("replay_from_node_id")
  /**
   * H2-06: gravado em TODO claim (enfileiramento inicial e cada retomada pos-
   * pausa) — e o que o orphan recovery usa pra decidir "travou" em vez de
   * `startedAt`, que nunca muda e faria uma execucao retomada virar elegivel
   * a ser morta no proximo boot de worker.
   */
  runStartedAt          DateTime? @map("run_started_at")
  suspendedAt           DateTime? @map("suspended_at")
  /** Soma do tempo de execucao real (fora das pausas) — sem isso, durationMs contaria os dias parados. */
  elapsedMsBeforePause  Int?      @map("elapsed_ms_before_pause")

  workflow      Workflow             @relation(fields: [workflowId], references: [id], onDelete: Cascade)
  version       WorkflowVersion      @relation(fields: [versionId], references: [id])
  steps         ExecutionStep[]
  logs          ExecutionLog[]
  parent        Execution?           @relation("Replay", fields: [parentExecutionId], references: [id])
  replays       Execution[]          @relation("Replay")
  aiSuggestions AiSuggestion[]
  pausedState   ExecutionPausedState?
  approvals     Approval[]

  @@index([workflowId])
  @@index([traceId])
  @@map("executions")
}

/**
 * H2-06: frontier da engine (nodeOutputs/vars/executed/mergeBuffers/...)
 * enquanto a execucao esta `waiting_approval`. Tabela separada, NAO coluna em
 * Execution: executions.service.ts:list() usa `include` sem `select`, e uma
 * coluna Json aqui devolveria ate 100 blobs de frontier por pagina — a
 * relacao so vem quando alguem pede explicitamente.
 */
model ExecutionPausedState {
  executionId String   @id @map("execution_id")
  version     Int      @default(1)
  state       Json
  createdAt   DateTime @default(now()) @map("created_at")

  execution Execution @relation(fields: [executionId], references: [id], onDelete: Cascade)

  @@map("execution_paused_states")
}

/** O que de fato aconteceu — "void" e usado quando a execucao termina (por qualquer caminho) com a aprovacao ainda aberta. */
enum ApprovalDecisionValue {
  approved
  rejected
  void
}

/** O que fazer quando o prazo estoura sem decisao — subconjunto deliberado de ApprovalDecisionValue (nunca "void"). */
enum ApprovalTimeoutAction {
  approve
  reject
}

/**
 * H2-06: pendencia criada pelo RPC ctx.requestApproval (node approval.human).
 * `@@unique([executionId, nodeId])` fecha a janela de retry do sandbox: se o
 * worker morrer DEPOIS do RPC criar a linha mas ANTES do node terminar, a
 * proxima tentativa cai no mesmo par em vez de duplicar. Cada tentativa emite
 * um token novo, mas o anterior continua valendo enquanto a pendencia estiver
 * aberta (previousTokenHashes) — ver ApprovalsService.create.
 */
model Approval {
  id          String    @id @default(uuid())
  executionId String    @map("execution_id")
  /** Denormalizado do Workflow — evita join pra listar/filtrar por workspace (GET /approvals). */
  workspaceId String    @map("workspace_id")
  nodeId      String    @map("node_id")
  title       String
  tokenHash   String    @unique @map("token_hash")
  /** Hashes dos tokens de tentativas anteriores do MESMO ciclo — links ja enviados por e-mail que continuam valendo. Zerado quando a pendencia e reaberta depois de uma decisao (ApprovalsService.create). */
  previousTokenHashes String[] @default([]) @map("previous_token_hashes")
  expiresAt   DateTime  @map("expires_at")
  onTimeout   ApprovalTimeoutAction @default(reject) @map("on_timeout")

  decidedAt  DateTime?              @map("decided_at")
  decision   ApprovalDecisionValue?
  decidedBy  String?                @map("decided_by")
  comment    String?

  /** Preenchido so depois que executions.enqueueResume() de fato enfileirou — o sweeper reenfileira se ficar null (worker morreu entre decidir e enfileirar). */
  resumeEnqueuedAt DateTime? @map("resume_enqueued_at")
  resumeAttempts   Int       @default(0) @map("resume_attempts")

  createdAt DateTime @default(now()) @map("created_at")

  execution Execution @relation(fields: [executionId], references: [id], onDelete: Cascade)

  @@unique([executionId, nodeId])
  @@index([workspaceId, decidedAt])
  @@index([decidedAt, expiresAt])
  /** A busca por token bruto casa `tokenHash` (btree do @unique) OU um elemento deste array — sem GIN, o segundo lado do OR seria seq scan na tabela inteira a cada GET /approve/:token. */
  @@index([previousTokenHashes], type: Gin)
  @@map("approvals")
}

model ExecutionStep {
  id          String          @id @default(uuid())
  executionId String          @map("execution_id")
  nodeId      String          @map("node_id")
  nodeType    String          @map("node_type")
  status      ExecutionStatus
  input       Json?
  output      Json?
  error       String?
  durationMs  Int?            @map("duration_ms")
  tokens      Int?
  model       String?
  costUsd     Float?          @map("cost_usd")
  /** Heap usado pelo processo do worker logo apos o node terminar, em MB. */
  memoryMb    Float?          @map("memory_mb")
  /**
   * Patch de $vars produzido por este step (hoje so logic.setVariables) —
   * NULL em todo step que nao mexe em variavel. Existe pro replay parcial
   * reconstituir o $vars acumulado antes do ponto de replay; sem isso, os
   * ancestrais reaproveitados devolvem output mas nao variavel.
   */
  varsPatch   Json?           @map("vars_patch")
  startedAt   DateTime        @default(now()) @map("started_at")
  finishedAt  DateTime?       @map("finished_at")
  attempt     Int             @default(1)

  execution Execution @relation(fields: [executionId], references: [id], onDelete: Cascade)

  @@index([executionId])
  @@map("execution_steps")
}

enum LogLevel {
  debug
  info
  warn
  error
}

model ExecutionLog {
  id          String   @id @default(uuid())
  executionId String   @map("execution_id")
  nodeId      String?  @map("node_id")
  level       LogLevel @default(info)
  event       String
  payload     Json?
  createdAt   DateTime @default(now()) @map("created_at")

  execution Execution @relation(fields: [executionId], references: [id], onDelete: Cascade)

  @@index([executionId])
  @@map("execution_logs")
}

model Agent {
  id           String   @id @default(uuid())
  workspaceId  String   @map("workspace_id")
  name         String
  description  String?
  systemPrompt String   @map("system_prompt")
  provider     String   @default("anthropic")
  model        String
  credential   String   @default("")
  temperature  Float    @default(0.7)
  /** Nomes das tools habilitadas: ["http", "calculator", "sql", "knowledge_base"]. */
  tools           Json     @default("[]")
  outputSchema    Json?    @map("output_schema")
  /** Base de conhecimento usada pela tool "knowledge_base", se habilitada. */
  knowledgeBaseId String?  @map("knowledge_base_id")
  createdAt       DateTime @default(now()) @map("created_at")

  workspace     Workspace      @relation(fields: [workspaceId], references: [id], onDelete: Cascade)
  memories      AgentMemory[]
  knowledgeBase KnowledgeBase? @relation(fields: [knowledgeBaseId], references: [id], onDelete: SetNull)

  @@index([workspaceId])
  @@map("agents")
}

/// Templates: workspace_id NULL = catalogo global seedado; preenchido = do
/// workspace (ADR-006). Listagem = globais + do workspace atual.
model Template {
  id          String   @id @default(uuid())
  workspaceId String?  @map("workspace_id")
  name        String
  description String
  category    String
  graph       Json
  createdAt   DateTime @default(now()) @map("created_at")

  workspace Workspace? @relation(fields: [workspaceId], references: [id], onDelete: Cascade)

  @@unique([workspaceId, name])
  @@map("templates")
}

model AgentMemory {
  id        String   @id @default(uuid())
  agentId   String   @map("agent_id")
  key       String
  value     String
  updatedAt DateTime @updatedAt @map("updated_at")

  agent Agent @relation(fields: [agentId], references: [id], onDelete: Cascade)

  @@unique([agentId, key])
  @@map("agent_memories")
}

/// Fase 7 (RAG). Embeddings gerados por OpenAI/Gemini/Ollama — Anthropic nao
/// tem API de embeddings publica. v1 fixa a dimensao do vetor em 1536
/// (text-embedding-3-small da OpenAI); outros providers ficam para depois.
model KnowledgeBase {
  id           String   @id @default(uuid())
  workspaceId  String   @map("workspace_id")
  name         String
  description  String?
  provider     String   @default("openai")
  model        String   @default("text-embedding-3-small")
  credential   String   @default("")
  chunkSize    Int      @default(1000) @map("chunk_size")
  chunkOverlap Int      @default(150) @map("chunk_overlap")
  createdAt    DateTime @default(now()) @map("created_at")

  workspace Workspace  @relation(fields: [workspaceId], references: [id], onDelete: Cascade)
  documents Document[]
  agents    Agent[]

  @@index([workspaceId])
  @@map("knowledge_bases")
}

enum DocumentStatus {
  processing
  ready
  failed
}

model Document {
  id              String         @id @default(uuid())
  knowledgeBaseId String         @map("knowledge_base_id")
  name            String
  sourceType      String         @map("source_type")
  status          DocumentStatus @default(processing)
  error           String?
  chunkCount      Int            @default(0) @map("chunk_count")
  /** Texto bruto extraido, mantido para reprocessamento/debug. */
  rawText         String?        @map("raw_text")
  createdAt       DateTime       @default(now()) @map("created_at")

  knowledgeBase KnowledgeBase @relation(fields: [knowledgeBaseId], references: [id], onDelete: Cascade)
  chunks        Chunk[]

  @@index([knowledgeBaseId])
  @@map("documents")
}

model Chunk {
  id         String                       @id @default(uuid())
  documentId String                       @map("document_id")
  content    String
  metadata   Json?
  /** Vetor pgvector — manipulado via $queryRaw/$executeRaw (tipo Unsupported). */
  embedding  Unsupported("vector(1536)")?
  createdAt  DateTime                     @default(now()) @map("created_at")

  document Document @relation(fields: [documentId], references: [id], onDelete: Cascade)

  @@index([documentId])
  @@map("chunks")
}

// ATENCAO: existe um indice HNSW em chunks.embedding (`chunks_embedding_hnsw_idx`,
// criado via SQL bruto na migration 20260724030000_knowledge_rag) que o Prisma
// nao consegue representar em schema (coluna Unsupported). Isso faz o
// `prisma migrate dev` tratar esse indice como "drift" e gerar um DROP INDEX
// automatico em QUALQUER nova migration — ja aconteceu uma vez (Fase 11) e
// derrubou o indice do banco de dev local sem aviso. Sempre que rodar
// `migrate dev`/`migrate diff`, revise o migration.sql gerado e remova
// manualmente qualquer `DROP INDEX "chunks_embedding_hnsw_idx"` antes de
// aplicar (e recrie o indice se ja tiver aplicado por engano).

/// Fase 8 (MCP). Conexao fica em memoria no processo da API (ADR-005/ADR-003
/// ja assumem worker single-process); reconecta sob demanda a partir da
/// config persistida aqui quando necessario (ex.: apos restart do processo).
enum McpTransport {
  stdio
  sse
  http
}

enum McpServerStatus {
  connecting
  connected
  disconnected
  error
}

model McpServer {
  id            String          @id @default(uuid())
  workspaceId   String          @map("workspace_id")
  name          String
  transport     McpTransport
  /** Comando do processo (transport stdio). */
  command       String?
  args          Json?
  env           Json?
  /** URL do servidor remoto (transport sse/http). */
  url           String?
  headers       Json?
  status        McpServerStatus @default(disconnected)
  lastError     String?         @map("last_error")
  lastCheckedAt DateTime?       @map("last_checked_at")
  createdAt     DateTime        @default(now()) @map("created_at")

  workspace Workspace @relation(fields: [workspaceId], references: [id], onDelete: Cascade)
  tools     McpTool[]

  @@index([workspaceId])
  @@map("mcp_servers")
}

model McpTool {
  id          String   @id @default(uuid())
  mcpServerId String   @map("mcp_server_id")
  name        String
  description String?
  inputSchema Json     @map("input_schema")
  createdAt   DateTime @default(now()) @map("created_at")

  mcpServer McpServer @relation(fields: [mcpServerId], references: [id], onDelete: Cascade)

  @@unique([mcpServerId, name])
  @@map("mcp_tools")
}

/** Fase 11: IA generativa de plataforma (Autocomplete, Copilot, Debugger, Cost Optimizer). */
enum AiSuggestionType {
  autocomplete
  copilot
  debugger
  cost_optimizer
}

enum AiSuggestionStatus {
  pending
  accepted
  rejected
}

/**
 * Telemetria de sugestoes de IA (Fase 11): registra toda sugestao gerada pelas
 * 4 features e se o usuario aceitou ou rejeitou, para poder medir/melhorar os
 * prompts internos depois.
 */
model AiSuggestion {
  id          String             @id @default(uuid())
  workspaceId String             @map("workspace_id")
  workflowId  String?            @map("workflow_id")
  executionId String?            @map("execution_id")
  type        AiSuggestionType
  /** Conteudo especifico do tipo: grafo gerado, causa+fixes, troca de modelo, diff proposto. */
  payload     Json
  status      AiSuggestionStatus @default(pending)
  /** Ausentes quando o tipo nao chama LLM (ex.: cost_optimizer, heuristica sobre ExecutionStep). */
  model        String?
  inputTokens  Int?              @map("input_tokens")
  outputTokens Int?              @map("output_tokens")
  costUsd      Float?            @map("cost_usd")
  createdAt   DateTime           @default(now()) @map("created_at")
  resolvedAt  DateTime?          @map("resolved_at")

  workspace Workspace  @relation(fields: [workspaceId], references: [id], onDelete: Cascade)
  workflow  Workflow?  @relation(fields: [workflowId], references: [id], onDelete: Cascade)
  execution Execution? @relation(fields: [executionId], references: [id], onDelete: Cascade)

  @@index([workspaceId])
  @@index([workflowId])
  @@map("ai_suggestions")
}

/**
 * Fase 12 (Chat trigger): conversa de um fluxo conversacional, identificada
 * por canal + chave externa. `channel` e uma string livre (nao enum) de
 * proposito — WhatsApp/Telegram/Discord entram depois sem migration; so o
 * canal "web" (chat publico da propria plataforma) e implementado agora.
 * `externalKey` e nulo no canal web (a conversa e identificada so pelo id,
 * guardado no localStorage do visitante); em canais externos seria o id do
 * contato no provedor (numero de telefone, chat id etc.).
 */
model Conversation {
  id          String   @id @default(uuid())
  workflowId  String   @map("workflow_id")
  channel     String   @default("web")
  externalKey String?  @map("external_key")
  /** Espelha $vars da ultima execucao concluida com sucesso — carrinho, etapa etc. */
  state       Json     @default("{}")
  status      String   @default("open")
  createdAt   DateTime @default(now()) @map("created_at")
  updatedAt   DateTime @updatedAt @map("updated_at")

  workflow Workflow              @relation(fields: [workflowId], references: [id], onDelete: Cascade)
  messages ConversationMessage[]

  @@unique([workflowId, channel, externalKey])
  @@index([workflowId, updatedAt])
  @@map("conversations")
}

model ConversationMessage {
  id             String   @id @default(uuid())
  conversationId String   @map("conversation_id")
  /** "user" (visitante) | "bot" (node chat.reply) | "operator" (inbox humano). */
  role           String
  content        String
  /** Execucao que gerou esta mensagem, quando role = "bot". */
  executionId    String?  @map("execution_id")
  createdAt      DateTime @default(now()) @map("created_at")

  conversation Conversation @relation(fields: [conversationId], references: [id], onDelete: Cascade)

  @@index([conversationId, createdAt])
  @@map("conversation_messages")
}
