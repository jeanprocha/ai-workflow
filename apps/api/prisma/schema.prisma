// Modelo de dados do Workflow AI Platform (ver plan.md secao 3).
// Multi-tenancy por workspace desde a Fase 2 (ADR-006): todo recurso de
// negocio abaixo carrega workspace_id.

generator client {
  provider        = "prisma-client-js"
  previewFeatures = ["postgresqlExtensions"]
}

datasource db {
  provider   = "postgresql"
  url        = env("DATABASE_URL")
  extensions = [vector]
}

model User {
  id           String   @id @default(uuid())
  email        String   @unique
  name         String
  passwordHash String   @map("password_hash")
  createdAt    DateTime @default(now()) @map("created_at")

  memberships      WorkspaceMember[]
  createdVersions  WorkflowVersion[]

  @@map("users")
}

enum WorkspaceRole {
  owner
  admin
  member
}

model Workspace {
  id        String   @id @default(uuid())
  name      String
  createdAt DateTime @default(now()) @map("created_at")

  members        WorkspaceMember[]
  workflows      Workflow[]
  credentials    Credential[]
  variables      Variable[]
  agents         Agent[]
  knowledgeBases KnowledgeBase[]
  mcpServers     McpServer[]
  aiSuggestions  AiSuggestion[]

  @@map("workspaces")
}

model WorkspaceMember {
  workspaceId String        @map("workspace_id")
  userId      String        @map("user_id")
  role        WorkspaceRole @default(member)
  createdAt   DateTime      @default(now()) @map("created_at")

  workspace Workspace @relation(fields: [workspaceId], references: [id], onDelete: Cascade)
  user      User      @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@id([workspaceId, userId])
  @@index([userId])
  @@map("workspace_members")
}

enum WorkflowStatus {
  draft
  active
  archived
}

model Workflow {
  id                String         @id @default(uuid())
  workspaceId       String         @map("workspace_id")
  name              String
  description       String?
  status            WorkflowStatus @default(draft)
  currentVersionId  String?        @unique @map("current_version_id")
  /** Sincronizado a cada save do grafo: id do node trigger.webhook, se houver. */
  webhookId         String?        @unique @map("webhook_id")
  createdAt         DateTime       @default(now()) @map("created_at")
  updatedAt         DateTime       @updatedAt @map("updated_at")

  workspace      Workspace         @relation(fields: [workspaceId], references: [id], onDelete: Cascade)
  versions       WorkflowVersion[] @relation("WorkflowVersions")
  currentVersion WorkflowVersion?  @relation("CurrentVersion", fields: [currentVersionId], references: [id])
  executions     Execution[]
  aiSuggestions  AiSuggestion[]

  @@index([workspaceId])
  @@map("workflows")
}

model WorkflowVersion {
  id            String   @id @default(uuid())
  workflowId    String   @map("workflow_id")
  versionNumber Int      @map("version_number")
  graph         Json
  createdById   String   @map("created_by")
  createdAt     DateTime @default(now()) @map("created_at")

  workflow    Workflow    @relation("WorkflowVersions", fields: [workflowId], references: [id], onDelete: Cascade)
  createdBy   User        @relation(fields: [createdById], references: [id])
  currentOf   Workflow?   @relation("CurrentVersion")
  executions  Execution[]

  @@unique([workflowId, versionNumber])
  @@map("workflow_versions")
}

model Credential {
  id            String   @id @default(uuid())
  workspaceId   String   @map("workspace_id")
  provider      String
  name          String
  encryptedData String   @map("encrypted_data")
  lastFour      String?  @map("last_four")
  createdAt     DateTime @default(now()) @map("created_at")

  workspace Workspace @relation(fields: [workspaceId], references: [id], onDelete: Cascade)

  // Unico por nome dentro do workspace: todo consumidor (engine, agents,
  // copilot, debugger, autocomplete) resolve credencial pelo NOME via
  // findFirst — com duplicata, qual delas vence seria indefinido.
  @@unique([workspaceId, name])
  @@index([workspaceId])
  @@map("credentials")
}

enum VariableScope {
  global
  environment
  runtime
}

model Variable {
  id          String        @id @default(uuid())
  workspaceId String        @map("workspace_id")
  key         String
  value       String
  isSecret    Boolean       @default(false) @map("is_secret")
  scope       VariableScope @default(global)
  createdAt   DateTime      @default(now()) @map("created_at")

  workspace Workspace @relation(fields: [workspaceId], references: [id], onDelete: Cascade)

  @@unique([workspaceId, key])
  @@map("variables")
}

enum ExecutionStatus {
  queued
  running
  success
  failed
  canceled
}

enum TriggerType {
  manual
  webhook
  cron
  event
}

model Execution {
  id                String          @id @default(uuid())
  workflowId        String          @map("workflow_id")
  versionId         String          @map("version_id")
  status            ExecutionStatus @default(queued)
  triggerType       TriggerType     @map("trigger_type")
  inputPayload      Json?           @map("input_payload")
  outputPayload     Json?           @map("output_payload")
  durationMs        Int?            @map("duration_ms")
  tokensTotal       Int             @default(0) @map("tokens_total")
  costUsd           Float           @default(0) @map("cost_usd")
  startedAt         DateTime        @default(now()) @map("started_at")
  finishedAt        DateTime?       @map("finished_at")
  error             String?
  parentExecutionId String?         @map("parent_execution_id")
  /** Agrupa uma execucao com todos os seus replays (Fase 6). Nula em execucoes anteriores a Fase 6. */
  traceId           String?         @map("trace_id")
  /** Node a partir do qual esta execucao foi um replay parcial, se houver. */
  replayFromNodeId  String?         @map("replay_from_node_id")

  workflow      Workflow        @relation(fields: [workflowId], references: [id], onDelete: Cascade)
  version       WorkflowVersion @relation(fields: [versionId], references: [id])
  steps         ExecutionStep[]
  logs          ExecutionLog[]
  parent        Execution?      @relation("Replay", fields: [parentExecutionId], references: [id])
  replays       Execution[]     @relation("Replay")
  aiSuggestions AiSuggestion[]

  @@index([workflowId])
  @@index([traceId])
  @@map("executions")
}

model ExecutionStep {
  id          String          @id @default(uuid())
  executionId String          @map("execution_id")
  nodeId      String          @map("node_id")
  nodeType    String          @map("node_type")
  status      ExecutionStatus
  input       Json?
  output      Json?
  error       String?
  durationMs  Int?            @map("duration_ms")
  tokens      Int?
  model       String?
  costUsd     Float?          @map("cost_usd")
  /** Heap usado pelo processo do worker logo apos o node terminar, em MB. */
  memoryMb    Float?          @map("memory_mb")
  startedAt   DateTime        @default(now()) @map("started_at")
  finishedAt  DateTime?       @map("finished_at")
  attempt     Int             @default(1)

  execution Execution @relation(fields: [executionId], references: [id], onDelete: Cascade)

  @@index([executionId])
  @@map("execution_steps")
}

enum LogLevel {
  debug
  info
  warn
  error
}

model ExecutionLog {
  id          String   @id @default(uuid())
  executionId String   @map("execution_id")
  nodeId      String?  @map("node_id")
  level       LogLevel @default(info)
  event       String
  payload     Json?
  createdAt   DateTime @default(now()) @map("created_at")

  execution Execution @relation(fields: [executionId], references: [id], onDelete: Cascade)

  @@index([executionId])
  @@map("execution_logs")
}

model Agent {
  id           String   @id @default(uuid())
  workspaceId  String   @map("workspace_id")
  name         String
  description  String?
  systemPrompt String   @map("system_prompt")
  provider     String   @default("anthropic")
  model        String
  credential   String   @default("")
  temperature  Float    @default(0.7)
  /** Nomes das tools habilitadas: ["http", "calculator", "sql", "knowledge_base"]. */
  tools           Json     @default("[]")
  outputSchema    Json?    @map("output_schema")
  /** Base de conhecimento usada pela tool "knowledge_base", se habilitada. */
  knowledgeBaseId String?  @map("knowledge_base_id")
  createdAt       DateTime @default(now()) @map("created_at")

  workspace     Workspace      @relation(fields: [workspaceId], references: [id], onDelete: Cascade)
  memories      AgentMemory[]
  knowledgeBase KnowledgeBase? @relation(fields: [knowledgeBaseId], references: [id], onDelete: SetNull)

  @@index([workspaceId])
  @@map("agents")
}

/// Catalogo global de templates oficiais — excecao deliberada ao ADR-006:
/// nao carrega workspace_id porque e compartilhado entre todos os workspaces.
model Template {
  id          String   @id @default(uuid())
  name        String
  description String
  category    String
  graph       Json
  createdAt   DateTime @default(now()) @map("created_at")

  @@map("templates")
}

model AgentMemory {
  id        String   @id @default(uuid())
  agentId   String   @map("agent_id")
  key       String
  value     String
  updatedAt DateTime @updatedAt @map("updated_at")

  agent Agent @relation(fields: [agentId], references: [id], onDelete: Cascade)

  @@unique([agentId, key])
  @@map("agent_memories")
}

/// Fase 7 (RAG). Embeddings gerados por OpenAI/Gemini/Ollama — Anthropic nao
/// tem API de embeddings publica. v1 fixa a dimensao do vetor em 1536
/// (text-embedding-3-small da OpenAI); outros providers ficam para depois.
model KnowledgeBase {
  id           String   @id @default(uuid())
  workspaceId  String   @map("workspace_id")
  name         String
  description  String?
  provider     String   @default("openai")
  model        String   @default("text-embedding-3-small")
  credential   String   @default("")
  chunkSize    Int      @default(1000) @map("chunk_size")
  chunkOverlap Int      @default(150) @map("chunk_overlap")
  createdAt    DateTime @default(now()) @map("created_at")

  workspace Workspace  @relation(fields: [workspaceId], references: [id], onDelete: Cascade)
  documents Document[]
  agents    Agent[]

  @@index([workspaceId])
  @@map("knowledge_bases")
}

enum DocumentStatus {
  processing
  ready
  failed
}

model Document {
  id              String         @id @default(uuid())
  knowledgeBaseId String         @map("knowledge_base_id")
  name            String
  sourceType      String         @map("source_type")
  status          DocumentStatus @default(processing)
  error           String?
  chunkCount      Int            @default(0) @map("chunk_count")
  /** Texto bruto extraido, mantido para reprocessamento/debug. */
  rawText         String?        @map("raw_text")
  createdAt       DateTime       @default(now()) @map("created_at")

  knowledgeBase KnowledgeBase @relation(fields: [knowledgeBaseId], references: [id], onDelete: Cascade)
  chunks        Chunk[]

  @@index([knowledgeBaseId])
  @@map("documents")
}

model Chunk {
  id         String                       @id @default(uuid())
  documentId String                       @map("document_id")
  content    String
  metadata   Json?
  /** Vetor pgvector — manipulado via $queryRaw/$executeRaw (tipo Unsupported). */
  embedding  Unsupported("vector(1536)")?
  createdAt  DateTime                     @default(now()) @map("created_at")

  document Document @relation(fields: [documentId], references: [id], onDelete: Cascade)

  @@index([documentId])
  @@map("chunks")
}

// ATENCAO: existe um indice HNSW em chunks.embedding (`chunks_embedding_hnsw_idx`,
// criado via SQL bruto na migration 20260724030000_knowledge_rag) que o Prisma
// nao consegue representar em schema (coluna Unsupported). Isso faz o
// `prisma migrate dev` tratar esse indice como "drift" e gerar um DROP INDEX
// automatico em QUALQUER nova migration — ja aconteceu uma vez (Fase 11) e
// derrubou o indice do banco de dev local sem aviso. Sempre que rodar
// `migrate dev`/`migrate diff`, revise o migration.sql gerado e remova
// manualmente qualquer `DROP INDEX "chunks_embedding_hnsw_idx"` antes de
// aplicar (e recrie o indice se ja tiver aplicado por engano).

/// Fase 8 (MCP). Conexao fica em memoria no processo da API (ADR-005/ADR-003
/// ja assumem worker single-process); reconecta sob demanda a partir da
/// config persistida aqui quando necessario (ex.: apos restart do processo).
enum McpTransport {
  stdio
  sse
  http
}

enum McpServerStatus {
  connecting
  connected
  disconnected
  error
}

model McpServer {
  id            String          @id @default(uuid())
  workspaceId   String          @map("workspace_id")
  name          String
  transport     McpTransport
  /** Comando do processo (transport stdio). */
  command       String?
  args          Json?
  env           Json?
  /** URL do servidor remoto (transport sse/http). */
  url           String?
  headers       Json?
  status        McpServerStatus @default(disconnected)
  lastError     String?         @map("last_error")
  lastCheckedAt DateTime?       @map("last_checked_at")
  createdAt     DateTime        @default(now()) @map("created_at")

  workspace Workspace @relation(fields: [workspaceId], references: [id], onDelete: Cascade)
  tools     McpTool[]

  @@index([workspaceId])
  @@map("mcp_servers")
}

model McpTool {
  id          String   @id @default(uuid())
  mcpServerId String   @map("mcp_server_id")
  name        String
  description String?
  inputSchema Json     @map("input_schema")
  createdAt   DateTime @default(now()) @map("created_at")

  mcpServer McpServer @relation(fields: [mcpServerId], references: [id], onDelete: Cascade)

  @@unique([mcpServerId, name])
  @@map("mcp_tools")
}

/** Fase 11: IA generativa de plataforma (Autocomplete, Copilot, Debugger, Cost Optimizer). */
enum AiSuggestionType {
  autocomplete
  copilot
  debugger
  cost_optimizer
}

enum AiSuggestionStatus {
  pending
  accepted
  rejected
}

/**
 * Telemetria de sugestoes de IA (Fase 11): registra toda sugestao gerada pelas
 * 4 features e se o usuario aceitou ou rejeitou, para poder medir/melhorar os
 * prompts internos depois.
 */
model AiSuggestion {
  id          String             @id @default(uuid())
  workspaceId String             @map("workspace_id")
  workflowId  String?            @map("workflow_id")
  executionId String?            @map("execution_id")
  type        AiSuggestionType
  /** Conteudo especifico do tipo: grafo gerado, causa+fixes, troca de modelo, diff proposto. */
  payload     Json
  status      AiSuggestionStatus @default(pending)
  /** Ausentes quando o tipo nao chama LLM (ex.: cost_optimizer, heuristica sobre ExecutionStep). */
  model        String?
  inputTokens  Int?              @map("input_tokens")
  outputTokens Int?              @map("output_tokens")
  costUsd      Float?            @map("cost_usd")
  createdAt   DateTime           @default(now()) @map("created_at")
  resolvedAt  DateTime?          @map("resolved_at")

  workspace Workspace  @relation(fields: [workspaceId], references: [id], onDelete: Cascade)
  workflow  Workflow?  @relation(fields: [workflowId], references: [id], onDelete: Cascade)
  execution Execution? @relation(fields: [executionId], references: [id], onDelete: Cascade)

  @@index([workspaceId])
  @@index([workflowId])
  @@map("ai_suggestions")
}
